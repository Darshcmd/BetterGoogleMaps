# FlowTwin / BetterGoogleMaps — environment configuration
# Copy to .env and adjust as needed:   cp .env.example .env
# All values are optional; every variable has a sensible default.

# --- Data & cache locations --------------------------------------------------
# Where downloaded GraphML region graphs and geocode caches are stored.
#FLOWTWIN_DATA_DIR=data

# --- OSM / Overpass ----------------------------------------------------------
# Comma-separated Overpass-compatible endpoints, probed in order.
# Override if the public mirrors are unreachable from your network.
#FLOWTWIN_OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.osm.jp/api/interpreter

# OSM download timeout in seconds.
#FLOWTWIN_OSMNX_TIMEOUT=240

# Overpass memory budget in MB.
#FLOWTWIN_OSMNX_MEMORY=3000

# --- BPR congestion model -----------------------------------------------------
# t_e(x) = t0_e * (1 + alpha * (x / capacity)^beta)
# Literature defaults for the US Bureau of Public Roads function.
#FLOWTWIN_BPR_ALPHA=0.15
#FLOWTWIN_BPR_BETA=4.0
